# Domain configuration
# For development: localhost
# For production: your-domain.com
DOMAIN=localhost
MATTERMOST_CONTAINER_READONLY=false

# PostgreSQL configuration
# DEVELOPMENT DEFAULTS - CHANGE FOR PRODUCTION!
# For production, use strong passwords and consider using secrets management
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmuser_password
POSTGRES_DB=mattermost

# Mattermost configuration paths
MATTERMOST_CONFIG_PATH=/mattermost/config/config.json
MATTERMOST_DATA_PATH=/mattermost/data/
MATTERMOST_LOGS_PATH=/mattermost/logs/
MATTERMOST_PLUGINS_PATH=/mattermost/plugins/
MATTERMOST_CLIENT_PLUGINS_PATH=/mattermost/client/plugins/
MATTERMOST_BLEVE_INDEXES_PATH=/mattermost/bleve-indexes/

# Timezone (use your local timezone, e.g., America/New_York, Europe/London, etc.)
TZ=UTC

# HTTP/HTTPS ports
HTTPS_PORT=443
HTTP_PORT=80
CALLS_PORT=8443

# Mattermost image configuration
# Use 'mattermost-team-edition' for free version or 'mattermost-enterprise-edition' for paid version
MATTERMOST_IMAGE=mattermost/mattermost-team-edition
# Specify version tag (e.g., 9.5, 10.0, latest)
MATTERMOST_IMAGE_TAG=latest

# PostgreSQL image tag
# Use PostgreSQL 14+ for Mattermost 11.x and later
POSTGRES_IMAGE_TAG=16-alpine

# Nginx image tag
NGINX_IMAGE_TAG=alpine
